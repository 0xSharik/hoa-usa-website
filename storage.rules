rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    // Note: 'request.auth != null' includes anonymous users.
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.admin == true;
    }
    
    // Public images - anyone can read, authenticated users can write
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Vendor logos - public read, authenticated users can write
    match /vendor-logos/{vendorId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Article thumbnails - public read, authenticated users can write
    match /article-thumbnails/{articleId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Video thumbnails - public read, authenticated users can write
    match /video-thumbnails/{videoId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Newsletter covers - public read, authenticated users can write
    match /newsletter-covers/{newsletterId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Complaint evidence files - public read, authenticated users can write
    match /complaints/evidence/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Complaint signature files - public read, authenticated users can write
    match /complaints/signatures/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Admin uploads - admin only
    match /admin-uploads/{allPaths=**} {
      allow read, write: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // User uploads - authenticated users can upload to their own folder
    match /user-uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Documents - public read, authenticated users can write
    match /documents/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Announcements - public read, authenticated users can write
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
